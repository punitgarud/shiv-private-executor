<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#000000">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHIV v4.0 Risk Protected"
        android:textColor="#00FF00"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Balance: 0.00 SOL"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvTop4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Top4 Live: Loading..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START EXECUTOR"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HISTORY &amp; PNL"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Logs: Risk Protected..."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
